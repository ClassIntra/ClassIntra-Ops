<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClassIntraOps.Launcher.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <!-- 品牌 accent：蓝紫 -->
            <Color x:Key="SystemAccentColor">#6366F1</Color>
            <Color x:Key="SystemAccentColorDark1">#5254D6</Color>
            <Color x:Key="SystemAccentColorDark2">#4343BD</Color>
            <Color x:Key="SystemAccentColorDark3">#34349E</Color>
            <Color x:Key="SystemAccentColorLight1">#7B7DF3</Color>
            <Color x:Key="SystemAccentColorLight2">#9B9CF7</Color>
            <Color x:Key="SystemAccentColorLight3">#BFBFFA</Color>

            <!-- 背景层次（窗口最深 → 侧栏 → 卡片 → 浮层）
                 精修：画布与卡片整体压深，拉开与文字/描边的对比 -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#08090C"/>
            <SolidColorBrush x:Key="AppSidebarBrush" Color="#0B0D11"/>
            <SolidColorBrush x:Key="AppCardBrush" Color="#101319"/>
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#1E2330"/>
            <SolidColorBrush x:Key="AppDividerBrush" Color="#171B23"/>
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#EDEFF3"/>
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#9AA3B2"/>
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#6B7484"/>
            <SolidColorBrush x:Key="AppTextDisabledBrush" Color="#4A5261"/>

            <!-- 井面 / 抬升面 / 悬停面 / 仪表槽 -->
            <SolidColorBrush x:Key="AppWellBrush" Color="#0A0C10"/>
            <SolidColorBrush x:Key="AppRaisedBrush" Color="#161A21"/>
            <SolidColorBrush x:Key="AppHoverBrush" Color="#161A21"/>
            <SolidColorBrush x:Key="MeterTrackBrush" Color="#1A1F2A"/>

            <!-- accent 柔和态：导航选中、次级强调、焦点 -->
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E2140"/>
            <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#3A3F7A"/>
            <SolidColorBrush x:Key="AccentSoftFgBrush" Color="#A5ACFF"/>
            <SolidColorBrush x:Key="NavActiveBrush" Color="#1E2140"/>
            <SolidColorBrush x:Key="NavActiveFgBrush" Color="#A5ACFF"/>

            <!-- 卡片微渐变（顶部略亮，模拟顶光） -->
            <LinearGradientBrush x:Key="CardSurfaceBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#131720" Offset="0"/>
                <GradientStop Color="#0F1218" Offset="1"/>
            </LinearGradientBrush>

            <!-- 多彩图标系（半透明圆底 + 亮色图标） -->
            <SolidColorBrush x:Key="IconPurpleBrush" Color="#A78BFA"/>
            <SolidColorBrush x:Key="IconPurpleBgBrush" Color="#2E8B5CF6"/>
            <SolidColorBrush x:Key="IconBlueBrush" Color="#60A5FA"/>
            <SolidColorBrush x:Key="IconBlueBgBrush" Color="#2E3B82F6"/>
            <SolidColorBrush x:Key="IconGreenBrush" Color="#34D399"/>
            <SolidColorBrush x:Key="IconGreenBgBrush" Color="#2E10B981"/>
            <SolidColorBrush x:Key="IconAmberBrush" Color="#FBBF24"/>
            <SolidColorBrush x:Key="IconAmberBgBrush" Color="#2EF59E0B"/>

            <!-- lime 高亮点缀 -->
            <SolidColorBrush x:Key="LimeBrush" Color="#A3E635"/>
            <SolidColorBrush x:Key="LimeBgBrush" Color="#26A3E635"/>

            <!-- 语义状态色（自包含，不依赖主题库） -->
            <SolidColorBrush x:Key="OkBgBrush" Color="#26A3E635"/>
            <SolidColorBrush x:Key="OkFgBrush" Color="#A3E635"/>
            <SolidColorBrush x:Key="WarnBgBrush" Color="#55350A"/>
            <SolidColorBrush x:Key="WarnFgBrush" Color="#FBBF24"/>
            <SolidColorBrush x:Key="ErrBgBrush" Color="#5C2020"/>
            <SolidColorBrush x:Key="ErrFgBrush" Color="#F87171"/>
            <SolidColorBrush x:Key="NeutralBgBrush" Color="#262B34"/>
            <SolidColorBrush x:Key="NeutralFgBrush" Color="#9AA2B0"/>

            <!-- 品牌渐变 -->
            <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#6366F1" Offset="0"/>
                <GradientStop Color="#A855F7" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- Semi Design 主题：接管基础控件质感 -->
        <StyleInclude Source="avares://Semi.Avalonia/Index.axaml"/>

        <!-- ============ 主操作按钮 ============ -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#7B7DF3"/>
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#5254D6"/>
        </Style>

        <!-- 小型按钮（行内操作 / 次级操作） -->
        <Style Selector="Button.btn-sm">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <!-- 幽灵按钮：无底色，悬停浮现（勾选切换、次级动作） -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>

        <!-- ============ 卡片 ============ -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <!-- 悬停时描边微亮：卡片"浮起"的暗示（Avalonia 12 XAML 过渡声明见注释于 row 样式） -->
        <Style Selector="Border.card:pointerover">
            <Setter Property="BorderBrush" Value="#2A3040"/>
        </Style>
        <!-- 悬停时描边微亮：卡片"浮起"的暗示 -->
        <Style Selector="Border.card:pointerover">
            <Setter Property="BorderBrush" Value="#2A3040"/>
        </Style>

        <!-- KPI 瓦片：与卡片同族 -->
        <Style Selector="Border.tile">
            <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style Selector="Border.stat">
            <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <!-- 表头 / 井面 -->
        <Style Selector="Border.tablehead">
            <Setter Property="Background" Value="{DynamicResource AppWellBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>

        <!-- ============ 状态胶囊 / chip ============ -->
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- ============ 列表行（圆角 hover，无分隔线，Linear 风） ============ -->
        <Style Selector="Border.row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="-12,0"/>
            <!-- 注：Avalonia 12 XAML 的 BrushTransition 声明会触发编译器 bug（AVLN2000），
                 hover 过渡如需要请在代码后置声明；当前采用即时切换 -->
        </Style>
        <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
        </Style>

        <!-- 行内操作：悬停浮现 -->
        <Style Selector="Border.row StackPanel.actions">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.row:pointerover StackPanel.actions">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- ============ 文字层级 ============ -->
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.cardtitle">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>
        <!-- 全大写小标签：字距拉开，大厂标签层级 -->
        <Style Selector="TextBlock.overline">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1.2"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextTertiaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.k">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextTertiaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.v">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.sub">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextTertiaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Consolas, DejaVu Sans Mono, monospace"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- 大号指标数字 -->
        <Style Selector="TextBlock.bignum">
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LineHeight" Value="42"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>
        <!-- KPI 数值：负字距更紧致 -->
        <Style Selector="TextBlock.metric">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="-0.5"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>

        <!-- ============ 仪表条（KPI 阈值进度） ============ -->
        <Style Selector="ProgressBar.meter">
            <Setter Property="Height" Value="4"/>
            <Setter Property="MinHeight" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource MeterTrackBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- ============ 终端式输出面 ============ -->
        <Style Selector="TextBox.terminal">
            <Setter Property="Background" Value="{DynamicResource AppWellBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas, DejaVu Sans Mono, monospace"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ============ 图标圆底 ============ -->
        <Style Selector="Border.iconbadge">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- ============ LIVE 呼吸点 ============ -->
        <Style Selector="Ellipse.livedot">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite" PlaybackDirection="AlternateReverse"
                           Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>
</Application>
