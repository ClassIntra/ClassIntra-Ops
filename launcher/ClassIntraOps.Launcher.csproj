<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 本机与发布机已有 .NET 10 运行时；self-contained 发布时该值不影响目标机 -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AssemblyName>ClassIntraOps</AssemblyName>
    <RootNamespace>ClassIntraOps.Launcher</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Avalonia 12 默认启用编译绑定；本项目展示模型为 partial 计算属性类，编译期解析不稳，恢复反射绑定 -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
  </ItemGroup>

</Project>
