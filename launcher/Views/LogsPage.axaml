<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClassIntraOps.Launcher.Views.LogsPage">
  <Border Classes="card">
    <Grid RowDefinitions="Auto,*,Auto">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="服务日志" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <ComboBox x:Name="FileBox" Width="190" SelectedIndex="0">
            <ComboBoxItem Content="server-out.log" Tag="out"/>
            <ComboBoxItem Content="server-error.log" Tag="error"/>
          </ComboBox>
          <Button x:Name="BtnRead" Content="读取尾部 300 行" Padding="12,5"/>
        </StackPanel>
      </Grid>
      <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" Margin="0,10,0,0"
               FontFamily="Consolas, DejaVu Sans Mono, monospace" FontSize="12"
               TextWrapping="NoWrap" AcceptsReturn="True"
               PlaceholderText="点击「读取」加载日志尾部。"/>
      <TextBlock Grid.Row="2" x:Name="LogMeta" Text="" FontSize="11" Opacity="0.6" Margin="0,8,0,0"/>
    </Grid>
  </Border>
</UserControl>
