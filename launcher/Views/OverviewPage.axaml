<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClassIntraOps.Launcher.Views.OverviewPage">

  <ScrollViewer>
    <StackPanel Spacing="14">

      <!-- ═══ 大数字状态卡 ═══ -->
      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="overline" Text="CLASSINTRA 服务状态"/>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
              <TextBlock x:Name="OnlineCount" Classes="bignum" Text="—"/>
              <TextBlock x:Name="OnlineTotal" Text="/ — 进程在线" FontSize="15"
                         Foreground="{DynamicResource AppTextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
            <TextBlock x:Name="StatusLine" Classes="sub" Margin="0,10,0,0" TextWrapping="Wrap"/>
          </StackPanel>

          <!-- LIVE 胶囊：呼吸点 + 文字 -->
          <Border x:Name="LivePill" Grid.Column="1" Classes="pill" VerticalAlignment="Top"
                  Background="{DynamicResource LimeBgBrush}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse x:Name="LiveDot" Classes="livedot" Width="6" Height="6"
                       Fill="{DynamicResource LimeBrush}" VerticalAlignment="Center"/>
              <TextBlock x:Name="LiveText" Text="LIVE" FontSize="11" FontWeight="Bold"
                         Foreground="{DynamicResource LimeBrush}"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- ═══ 资源历史柱状图 ═══ -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="资源使用 · 近 12 分钟" Classes="cardtitle" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
              <!-- 图例：色点 + 名称 + 实时数值 -->
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource IconPurpleBrush}" VerticalAlignment="Center"/>
                <TextBlock Classes="sub" Text="CPU" VerticalAlignment="Center"/>
                <TextBlock x:Name="CpuNow" Text="—" FontSize="11.5" FontWeight="SemiBold"
                           FontFamily="Consolas, DejaVu Sans Mono, monospace"
                           Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource IconBlueBrush}" VerticalAlignment="Center"/>
                <TextBlock Classes="sub" Text="内存" VerticalAlignment="Center"/>
                <TextBlock x:Name="MemNow" Text="—" FontSize="11.5" FontWeight="SemiBold"
                           FontFamily="Consolas, DejaVu Sans Mono, monospace"
                           Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource IconGreenBrush}" VerticalAlignment="Center"/>
                <TextBlock Classes="sub" Text="磁盘" VerticalAlignment="Center"/>
                <TextBlock x:Name="DiskNow" Text="—" FontSize="11.5" FontWeight="SemiBold"
                           FontFamily="Consolas, DejaVu Sans Mono, monospace"
                           Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- 图表区：柱体 + 底部基线 -->
          <Grid RowDefinitions="*,Auto">
            <ItemsControl x:Name="BarChart" Height="96">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" Columns="24"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom"
                              HorizontalAlignment="Left" Height="88"
                              IsVisible="{Binding HasBars}"
                              ToolTip.Tip="{Binding Label}">
                    <Rectangle Width="10" Height="{Binding CpuH}" Fill="{DynamicResource IconPurpleBrush}"
                               RadiusX="3" RadiusY="3" VerticalAlignment="Bottom"/>
                    <Rectangle Width="10" Height="{Binding MemH}" Fill="{DynamicResource IconBlueBrush}"
                               RadiusX="3" RadiusY="3" VerticalAlignment="Bottom"/>
                    <Rectangle Width="10" Height="{Binding DiskH}" Fill="{DynamicResource IconGreenBrush}"
                               RadiusX="3" RadiusY="3" VerticalAlignment="Bottom"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 基线 -->
            <Border Grid.Row="1" Height="1" Background="{DynamicResource AppDividerBrush}" Margin="0,4,0,0"/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto,*">
            <TextBlock x:Name="ChartFrom" Classes="sub" Text=""/>
            <TextBlock Grid.Column="1" Classes="sub" Text="30 秒 / 采样点"/>
            <TextBlock Grid.Column="2" Classes="sub" Text="现在" HorizontalAlignment="Right"
                       Foreground="{DynamicResource LimeBrush}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ═══ 进程列表 ═══ -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto" Margin="-6,0,0,6">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="进程" Classes="cardtitle" VerticalAlignment="Center"/>
              <Border x:Name="ProcCountPill" Classes="pill" Background="{DynamicResource NeutralBgBrush}"
                      Padding="8,2" VerticalAlignment="Center">
                <TextBlock x:Name="ProcCountText" Text="0" FontSize="10.5" FontWeight="Bold"
                           FontFamily="Consolas, DejaVu Sans Mono, monospace"
                           Foreground="{DynamicResource NeutralFgBrush}"/>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button x:Name="BtnStartAll" Content="启动全部" Classes="btn-sm"/>
              <Button x:Name="BtnApplyRestart" Content="应用配置重启" Classes="btn-sm"/>
            </StackPanel>
          </Grid>

          <TextBlock x:Name="ProcBanner" Text="" TextWrapping="Wrap" FontSize="12" IsVisible="False"
                     Foreground="{DynamicResource WarnFgBrush}" Margin="0,4,0,4"/>

          <ItemsControl x:Name="ProcList" Margin="0,0,-12,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="row">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="13">
                      <Border Classes="iconbadge" Background="{Binding IconBg}">
                        <TextBlock Text="{Binding IconGlyph}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{Binding IconFg}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <TextBlock Text="{Binding SubLine}" FontSize="11"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                      </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,18,0">
                      <TextBlock Text="{Binding MemText}" FontSize="13.5" FontWeight="Bold"
                                 Foreground="{DynamicResource LimeBrush}"
                                 FontFamily="Consolas, DejaVu Sans Mono, monospace"
                                 HorizontalAlignment="Right"/>
                      <TextBlock Text="{Binding CpuText}" FontSize="10"
                                 Foreground="{DynamicResource AppTextTertiaryBrush}"
                                 FontFamily="Consolas, DejaVu Sans Mono, monospace"
                                 HorizontalAlignment="Right" Margin="0,1,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="2" Classes="pill" Background="{Binding PillBg}" Padding="9,3"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold"
                                 Foreground="{Binding PillFg}"/>
                    </Border>

                    <StackPanel Grid.Column="3" Classes="actions" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" Margin="14,0,2,0">
                      <Button Content="重启" Classes="btn-sm" Tag="restart" Click="OnAction"/>
                      <Button Content="停止" Classes="btn-sm" Tag="stop" Click="OnAction"/>
                      <Button Content="删除" Classes="btn-sm" Tag="delete" Click="OnAction"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                     Foreground="{DynamicResource AppTextDisabledBrush}"
                     Text="悬停进程行出现操作按钮。「应用配置重启」执行 pm2 restart --update-env：改完 .env 必须走这个，普通 restart 保留旧环境变量，不会生效。"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
