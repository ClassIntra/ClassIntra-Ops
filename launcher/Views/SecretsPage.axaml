<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClassIntraOps.Launcher.Views.SecretsPage">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <Border Classes="card"
            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
            BorderBrush="Transparent" Padding="14">
      <TextBlock TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource SystemFillColorCautionBrush}"
                 Text="密钥字段不会回显明文：留空表示不修改，填写后才会覆盖写入 server/.env。保存前自动备份为 .env.bak-时间戳。"/>
    </Border>

    <Border Grid.Row="1" Classes="card" Margin="0,12,0,0" IsVisible="False" x:Name="SaveBannerBorder" Padding="14">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock x:Name="SaveBannerText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
        <Button x:Name="BtnApplyNow" Content="立即应用重启" Click="OnApplyRestart" Padding="12,4"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="2" Margin="0,12,0,0">
      <StackPanel x:Name="GroupsHost" Spacing="14"/>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="BtnToggle" Content="显示全部明文" Click="OnToggle"/>
      <Button x:Name="BtnSave" Content="保存" Click="OnSave" Classes="accent" Padding="22,6"/>
    </StackPanel>
  </Grid>
</UserControl>
