<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClassIntraOps.Launcher.Views.SecretsPage">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- 安全提示条 -->
    <Border Classes="card" Padding="12,9"
            Background="{DynamicResource AppWellBrush}"
            BorderBrush="{DynamicResource AppCardBorderBrush}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <PathIcon Width="13" Height="13" VerticalAlignment="Center"
                  Foreground="{DynamicResource AppTextSecondaryBrush}"
                  Data="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm0 6.8a1 1 0 0 1 1 1v4.4a1 1 0 0 1-2 0V7.8a1 1 0 0 1 1-1zm0-3.3a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2z"/>
        <TextBlock TextWrapping="Wrap" FontSize="11.5"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                   Text="密钥字段不会回显明文：留空表示不修改，填写后才会覆盖写入 server/.env。保存前自动备份为 .env.bak-时间戳。"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Classes="card" Margin="0,10,0,0" IsVisible="False"
            x:Name="SaveBannerBorder" Padding="12,9">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock x:Name="SaveBannerText" TextWrapping="Wrap" FontSize="11.5" VerticalAlignment="Center"
                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
        <Button x:Name="BtnApplyNow" Content="立即应用重启" Classes="btn-sm accent" Click="OnApplyRestart"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="2" Margin="0,10,0,0">
      <StackPanel x:Name="GroupsHost" Spacing="12"/>
    </ScrollViewer>

    <!-- 吸底操作栏 -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock x:Name="BarHint" VerticalAlignment="Center" FontSize="11"
                 Foreground="{DynamicResource AppTextTertiaryBrush}"
                 Text="改动需「应用配置重启」生效：普通 pm2 restart 不会重新加载 .env"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button x:Name="BtnToggle" Content="显示全部明文" Classes="ghost" Click="OnToggle"/>
        <Button x:Name="BtnSave" Content="保存并备份" Click="OnSave" Classes="accent" Padding="18,6"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
